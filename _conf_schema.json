{
  "api_key": {
    "description": "GRSAI API Key",
    "type": "string",
    "hint": "从 https://grsai.ai/zh/dashboard/api-keys 获取，不需要填写 Bearer 前缀。",
    "default": ""
  },
  "base_url": {
    "description": "GRSAI 基础节点",
    "type": "string",
    "hint": "国内节点一般更适合服务器在国内的场景。",
    "default": "https://grsai.dakka.com.cn"
  },
  "model": {
    "description": "默认模型",
    "type": "string",
    "options": ["gpt-image-2-vip", "gpt-image-2"],
    "hint": "文档说明 2K/4K 仅 gpt-image-2-vip 支持。",
    "default": "gpt-image-2-vip"
  },
  "default_ratio": {
    "description": "默认画幅比例",
    "type": "string",
    "options": ["1:1", "16:9", "9:16", "3:2", "2:3", "21:9", "9:21", "1:3", "3:1", "2:1", "1:2"],
    "default": "1:1"
  },
  "default_quality": {
    "description": "默认清晰度",
    "type": "string",
    "options": ["2k", "1k"],
    "hint": "4K 请在命令里使用 --4k。",
    "default": "2k"
  },
  "reply_type": {
    "description": "GRSAI 回复类型",
    "type": "string",
    "options": ["json"],
    "default": "json"
  },
  "timeout_seconds": {
    "description": "请求超时时间",
    "type": "int",
    "default": 180
  },
  "cooldown_seconds": {
    "description": "单用户冷却秒数",
    "type": "int",
    "default": 60
  },
  "allowed_user_ids": {
    "description": "允许使用的 QQ 号白名单",
    "type": "list",
    "hint": "留空表示所有人可用。填写字符串 QQ 号，例如 [\"123456\"]。",
    "default": []
  }
}
